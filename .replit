modules = ["rust"]

[nix]
channel = "stable-24_05"
packages = ["sqlite"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Lastrum Certifield"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "rust_app"

[[workflows.workflow]]
name = "Lastrum Certifield"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd $(pwd) && cargo build && cargo run"

[[workflows.workflow]]
name = "rust_app"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cargo run -- verify-certificate --certificate \"53b758eb-5731-447a-be9e-addd441fb300\""

[deployment]
run = ["sh", "-c", "cd $(pwd) && cargo build && cargo run"]
